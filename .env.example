# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Paths
CHROMA_PERSIST_DIRECTORY=./data/vectorstore
METADATA_CACHE_DIR=./data/metadata

# Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.3
MAX_TOKENS=2048

# Retrieval Configuration
TOP_K_RESULTS=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Metadata Extraction
ENABLE_METADATA_EXTRACTION=true
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.6

# Complexity Analysis
ENABLE_COMPLEXITY_ANALYSIS=true

# Impact Analysis
ENABLE_IMPACT_ANALYSIS=true

# Auto-Categorization
ENABLE_AUTO_CATEGORIZATION=true

# Filtering Configuration
DEFAULT_FILTER_LIMIT=20
MAX_FILTER_RESULTS=100

# UI Configuration
PROJECTS_PER_PAGE=12
CARDS_PER_ROW=3

# Collection Name
COLLECTION_NAME=project_ideas_collection
